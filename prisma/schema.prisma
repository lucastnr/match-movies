// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  ownedSessions Session[] @relation("SessionOwner")
  sessions      Session[] @relation("SessionParticipant")
  likes         Like[]    @relation("UserLikes")
}

model Session {
  id           String @id @default(cuid())
  ownerId      String
  owner        User   @relation("SessionOwner", fields: [ownerId], references: [id])
  participants User[] @relation("SessionParticipant")
  likes        Like[] @relation("SessionLike")
}

model Like {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("UserLikes", fields: [userId], references: [id])
  sessionId String
  session   Session @relation("SessionLike", fields: [sessionId], references: [id])
}
